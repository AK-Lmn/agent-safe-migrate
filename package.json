{
  "name": "mgcheck",
  "version": "0.2.8",
  "description": "Migration Guardian — Catch unsafe database migrations before they hit production",
  "type": "module",
  "bin": {
    "mgcheck": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "migration",
    "database",
    "postgresql",
    "postgres",
    "safety",
    "linter",
    "prisma",
    "drizzle",
    "sql",
    "ci",
    "mcp",
    "shadow-database",
    "migration-check"
  ],
  "author": "Aditya Gandhi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aditya31032006/agent-safe-migrate.git"
  },
  "homepage": "https://github.com/Aditya31032006/agent-safe-migrate#readme",
  "bugs": {
    "url": "https://github.com/Aditya31032006/agent-safe-migrate/issues"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dockerode": "^4.0.0",
    "ora": "^8.0.0",
    "pg": "^8.12.0",
    "pgsql-parser": "^13.16.0",
    "uuid": "^14.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
